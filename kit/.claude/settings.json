{
  "permissions": {
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git add -A *)",
      "Bash(git add --all *)",
      "Bash(git add . *)",
      "Bash(git commit -a *)",
      "Bash(git commit -am *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./secrets/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && { cat PROGRESS.md 2>/dev/null || echo 'No PROGRESS.md yet. This is a new project.'; } && { GIT_TERMINAL_PROMPT=0 git fetch -q 2>/dev/null; git status -sb 2>/dev/null; } ; true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "viewMode": "focus"
}
